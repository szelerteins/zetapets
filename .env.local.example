# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── MercadoPago ───────────────────────────────────────────────────────────────
# Credenciales de PRUEBA (sandbox) — obtener en:
# mercadopago.com.ar → Developers → Panel del desarrollador → Credenciales de prueba
MERCADOPAGO_SANDBOX_ACCESS_TOKEN=TEST-xxxx-xxxx-xxxx-xxxx

# Credenciales de PRODUCCIÓN — solo configurar en Vercel (nunca en .env.local)
# mercadopago.com.ar → Developers → Panel del desarrollador → Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# true  → usa MERCADOPAGO_SANDBOX_ACCESS_TOKEN (desarrollo/staging)
# false → usa MERCADOPAGO_ACCESS_TOKEN (producción en Vercel)
MP_SANDBOX=true

# ── Admin session (seguridad) ─────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurar el mismo valor en Vercel → Settings → Environment Variables
ADMIN_SESSION_SECRET=cambia-esto-por-un-string-aleatorio-de-64-caracteres

# Credenciales del admin (mover a variables de entorno, no hardcodear)
ADMIN_USERNAME=zetapets
ADMIN_EMAIL=zetapetsmascotas@gmail.com
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-segura

# ── URL pública de la app ─────────────────────────────────────────────────────
# En local con ngrok: https://xxxx.ngrok-free.app
# En producción: https://zetapets.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Gmail (Nodemailer) ────────────────────────────────────────────────────────
# Cómo obtener App Password: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
GMAIL_USER=zetapetsmascotas@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── WhatsApp (CallMeBot) ──────────────────────────────────────────────────────
# Instrucciones: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=5491XXXXXXXXX
CALLMEBOT_APIKEY=xxxxxxx

# ── Groq (Chatbot) ────────────────────────────────────────────────────────────
# Obtener en: console.groq.com → API Keys
GROQ_API_KEY=gsk_...
